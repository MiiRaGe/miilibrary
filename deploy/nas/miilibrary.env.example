# Copy to miilibrary.env next to docker-compose.yml. The cluster deployment needs the same values, except the ones
# marked [NAS] (only the filesystem worker uses them) and [cluster] (only the web UI / default worker use them).

# Database (postgres in the cluster, exposed on the LAN)
DB_ENGINE=django.db.backends.postgresql
DB_HOST=192.168.0.X
DB_PORT=5432
DB_NAME=media
DB_USER=miilibrary
DB_PASSWORD=change-me

# Celery broker and django cache, both reachable from the NAS. The cache holds the task locks, it must be shared.
BROKER_URL=redis://192.168.0.X:6379/0
CACHE_LOCATION=redis://192.168.0.X:6379/1

SECRET_KEY=change-me

# [NAS] metadata lookups done while sorting and indexing
OPENSUBTITLE_LOGIN=
OPENSUBTITLE_PASSWORD=

# [cluster] rss + transmission
RSS_URL=
TRANSMISSION_RPC_URL=http://192.168.0.X:9091/transmission/rpc
TRANSMISSION_RPC_USERNAME=
TRANSMISSION_RPC_PASSWORD=
# transmission's own path to the completed torrents folder
TRANSMISSION_DOWNLOAD_DIR=/downloads/complete
TORRENT_RETENTION_DAYS=90

# [cluster] web UI
EXTRA_ALLOWED_HOST=miilibrary.example.lan
EXTRA_ALLOWED_IP=192.168.0.X
DEBUG=false

# Optional
REPORT_ENABLED=true
SENTRY_URL=
