#!/usr/bin/with-contenv bash
# shellcheck shell=bash
# linuxserver custom init: runs as root on every start, after the image's own settings.json setup and before
# transmission starts, so these settings survive transmission rewriting settings.json when it stops.
# Copy to /share/Container/miilibrary/transmission-init/ on the NAS, owned by root (linuxserver skips other owners).

done_script=/config/torrent-done.sh

if [[ -n "${MIILIBRARY_URL}" ]]; then
    cat >"${done_script}" <<EOF
#!/bin/bash
# Generated by 90-miilibrary-settings on container start, edit MIILIBRARY_URL instead.
curl -fsS -m 30 -o /dev/null "${MIILIBRARY_URL%/}/rpc/unpack_sort_index"
EOF
    chmod 755 "${done_script}"
    chown abc:abc "${done_script}"
    done_enabled=true
else
    echo "[miilibrary] MIILIBRARY_URL is not set, torrent-done script disabled"
    done_enabled=false
fi

jq --argjson done_enabled "${done_enabled}" --arg done_script "${done_script}" '. + {
    "download-dir": "/downloads",
    "incomplete-dir-enabled": false,
    "rename-partial-files": true,
    "watch-dir-enabled": false,
    "script-torrent-done-enabled": $done_enabled,
    "script-torrent-done-filename": $done_script
}' /config/settings.json >/config/settings.json.tmp && mv /config/settings.json.tmp /config/settings.json
chown abc:abc /config/settings.json
